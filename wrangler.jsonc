{
  "name": "landing",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"]
  },
  "vars": {
    "CONTACT_FROM": "website@notify.creonity.com"
  },
  "send_email": [
    { "name": "INQUIRY_EMAIL", "allowed_destination_addresses": ["connect@creonity.com"] }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "304101",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
